{
  "esversion": 11,
  "browser": true,
  "node": false,
  "undef": true,
  "unused": true,
  "eqeqeq": true,
  "curly": false,
  "latedef": false,
  "globals": {
    "self": true,
    "globalThis": true,
    "TextDecoder": true,
    "TextEncoder": true,
    "fetch": true,
    "URL": true,
    "Blob": true,
    "File": true,
    "FileReader": true,
    "ReadableStream": true,
    "WritableStream": true,
    "TransformStream": true,
    "Worker": true,
    "SharedWorker": true,
    "reportError": true,
    "DOMParser": true,
    "XMLSerializer": true,
    "getComputedStyle": true,
    "ResizeObserver": true,
    "IntersectionObserver": true,
    "MutationObserver": true,
    "requestAnimationFrame": true,
    "cancelAnimationFrame": true,
    "setTimeout": true,
    "clearTimeout": true,
    "setInterval": true,
    "clearInterval": true,
    "queueMicrotask": true,
    "structuredClone": true,
    "crypto": true
  }
}
