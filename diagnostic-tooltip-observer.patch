+          const parentClass = parent?.className?.replace(/p-tooltip-target|p-focus/g, '').trim() || '';
+
+          console.warn(
+            `%c[TOOLTIP OBSERVER] %c"${text}" %c→ %c<${parentTag}${parentId} class="${parentClass}">`,
